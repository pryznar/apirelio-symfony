{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apirelio/symfony",
    "description": "Fail-safe Symfony SDK for Apirelio customer integration analytics.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "apirelio/php-core": "^0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Apirelio\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apirelio\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-core",
            "options": {
                "symlink": true,
                "versions": {
                    "apirelio/php-core": "0.2.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
